# Copy to .env and edit. Never commit .env to Git.

DATABASE_URL=sqlite:///./ledgerforge.db
DATA_DIR=data

# Generate your own secret before enabling login
LEDGERFORGE_JWT_SECRET=

# Configure only after verifying company details
# COMPANY_LEGAL_NAME=
# COMPANY_ADDRESS=
# COMPANY_CONTACT_EMAIL=
# COMPANY_CONTACT_PHONE=

# Local Docker PostgreSQL
POSTGRES_USER=ledger
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_PASSWORD_URLENCODED=replace_with_url_encoded_password

# Do not automatically load company data
SEED_COMPANY_DATA=false
