# Copy to .env and edit. Never commit .env to Git.
# Day 1: SQLite needs nothing installed. Later switch to PostgreSQL:
DATABASE_URL=sqlite:///./ledgerforge.db
# DATABASE_URL=postgresql+psycopg2://ledger:ledger@localhost:5432/ledgerforge
DATA_DIR=data
# Generate a unique random signing key of at least 32 bytes before enabling login.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
LEDGERFORGE_JWT_SECRET=
# Payslip legal details: replace these examples only with verified company values.
# Keep unset until verified; example placeholders are intentionally comments.
# COMPANY_LEGAL_NAME=REPLACE_WITH_REGISTERED_LEGAL_NAME
# COMPANY_ADDRESS=REPLACE_WITH_VERIFIED_LEGAL_ADDRESS
# COMPANY_CONTACT_EMAIL=REPLACE_WITH_VERIFIED_CONTACT_EMAIL
# COMPANY_CONTACT_PHONE=REPLACE_WITH_VERIFIED_CONTACT_PHONE

# Docker Compose (use unique local values; never commit your real .env)
POSTGRES_USER=ledger
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
SEED_COMPANY_DATA=true
